* text=auto eol=lf
*.py text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.pdf binary

# Keep the verified official MDPI dependency assets byte-for-byte intact.
manuscript/Definitions/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
# Preserve delivered/generated evidence whose native formatting includes spaces.
artifacts/strong_lensing_bhsm_integration_20261020/package_existing_text_changes.patch -text whitespace=-blank-at-eol,-blank-at-eof
manuscript/figures/r1_screening_prediction.svg -text whitespace=-blank-at-eol,-blank-at-eof
manuscript/figures/he0435_withheld_prediction.svg -text whitespace=-blank-at-eol,-blank-at-eof
artifacts/strong_lensing_bhsm_integration_20261020/replay/figures/r1_screening_prediction.svg -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve the delivered scientific snapshot's exact SHA-256 provenance.
analyses/sn_sightline_tomography_v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve original COSMOGRAIL/CDS observations and catalogue metadata bytes.
data/strong_lensing_observed_20261020/candidates/**/*.dat -text whitespace=-blank-at-eol,-blank-at-eof
data/strong_lensing_observed_20261020/candidates/**/*.txt -text whitespace=-blank-at-eol,-blank-at-eof
data/strong_lensing_observed_20261020/candidates/**/*.json -text whitespace=cr-at-eol
artifacts/strong_lensing_observed_20261020/*.json -text whitespace=cr-at-eol
